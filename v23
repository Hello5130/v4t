-- DEFAULT THEME
--===========================================================
local THEME = {
	Background = Color3.fromRGB(18, 18, 24),
	Panel      = Color3.fromRGB(26, 26, 34),
	Element    = Color3.fromRGB(34, 34, 46),
	Accent     = Color3.fromRGB(88, 101, 242),
