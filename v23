--===========================================================
-- UTILITIES
--===========================================================
local function tween(obj, time, props)
	TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
end

local function round(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function stroke(parent, color)
	local s = Instance.new("UIStroke")
	s.Color = color or THEME.Stroke
	s.Thickness = 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function label(parent, text, size, color, bold)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
	l.TextSize = size or 13
	l.TextColor3 = color or THEME.Text
	l.Text = text or ""
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

local function button(parent)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundTransparency = 1
	b.Text = ""
	b.Parent = parent
	return b
end

local function makeDraggable(handle, frame)
	local dragging, dragStart, startPos
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			tween(frame, 0.05, {Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y)})
		end
	end)
end

--===========================================================
-- CONFIG SYSTEM (Save/Load)
--===========================================================
local ConfigSystem = {}
ConfigSystem.Folder = "NovaLib_Configs"

function ConfigSystem:Setup()
	if not isfolder then return false end
	if not isfolder(self.Folder) then
		makefolder(self.Folder)
	end
	return true
end

function ConfigSystem:GetPath(name)
	return self.Folder .. "/" .. name .. ".json"
end

function ConfigSystem:Save(name, data)
	if not self:Setup() then return end
	local success, encoded = pcall(HttpService.JSONEncode, HttpService, data)
	if success then
		writefile(self:GetPath(name), encoded)
	end
end

function ConfigSystem:Load(name)
	if not self:Setup() then return nil end
	local path = self:GetPath(name)
	if isfile(path) then
		local success, data = pcall(HttpService.JSONDecode, HttpService, readfile(path))
		if success then return data end
	end
	return nil
end

