function Nova:VerifyKey(config)
	config = config or {}
	local correctKeys = config.Keys or {}
	local callback = config.Callback
	local title = config.Title or "Key System"
	local note = config.Note or "กรุณากรอก Key เพื่อเข้าใช้งาน"
	local theme = config.Theme or THEME

	local verified = false
	local gui = Instance.new("ScreenGui")
	gui.Name = "NovaKeySystem"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.IgnoreGuiInset = true
	gui.Parent = RunService:IsStudio()
		and LocalPlayer:WaitForChild("PlayerGui")
		or (gethui and gethui() or game:GetService("CoreGui"))

	local main = Instance.new("Frame")
	main.Size = UDim2.new(0, 400, 0, 220)
	main.Position = UDim2.new(0.5, -200, 0.5, -110)
	main.BackgroundColor3 = theme.Background
	main.BorderSizePixel = 0
	main.Parent = gui
	round(main, 12)
	stroke(main)

	local topbar = Instance.new("Frame")
	topbar.Size = UDim2.new(1, 0, 0, 44)
	topbar.BackgroundColor3 = theme.Panel
	topbar.BorderSizePixel = 0
	topbar.Parent = main
	round(topbar, 12)

	local titleLabel = label(topbar, title, 15, theme.Text, true)
	titleLabel.Position = UDim2.new(0, 16, 0, 0)
	titleLabel.Size = UDim2.new(1, -32, 1, 0)

	-- Close button
	local closeBtn = button(topbar)
	closeBtn.Size = UDim2.new(0, 30, 0, 30)
	closeBtn.Position = UDim2.new(1, -38, 0.5, -15)
	local closeBg = Instance.new("Frame")
	closeBg.Size = UDim2.new(1, 0, 1, 0)
	closeBg.BackgroundColor3 = theme.Element
	closeBg.BorderSizePixel = 0
	closeBg.Parent = closeBtn
	round(closeBg, 8)
	local closeText = label(closeBg, "×", 18, theme.SubText, true)
	closeText.Size = UDim2.new(1, 0, 1, 0)
	closeText.TextXAlignment = Enum.TextXAlignment.Center
	closeBtn.MouseButton1Click:Connect(function()
		tween(main, 0.2, {Size = UDim2.new(0, 400, 0, 0)})
		task.delay(0.2, function() gui:Destroy() end)
	end)

	makeDraggable(topbar, main)

	local noteLabel = label(main, note, 12, theme.SubText)
	noteLabel.Position = UDim2.new(0, 16, 0, 56)
	noteLabel.Size = UDim2.new(1, -32, 0, 20)
	noteLabel.TextXAlignment = Enum.TextXAlignment.Center

	local inputBg = Instance.new("Frame")
	inputBg.Size = UDim2.new(1, -32, 0, 40)
	inputBg.Position = UDim2.new(0, 16, 0, 90)
	inputBg.BackgroundColor3 = theme.Element
	inputBg.BorderSizePixel = 0
	inputBg.Parent = main
	round(inputBg, 8)
	stroke(inputBg)

	local inputBox = Instance.new("TextBox")
	inputBox.Size = UDim2.new(1, -20, 1, 0)
	inputBox.Position = UDim2.new(0, 10, 0, 0)
	inputBox.BackgroundTransparency = 1
	inputBox.Font = Enum.Font.Gotham
	inputBox.TextSize = 14
	inputBox.TextColor3 = theme.Text
	inputBox.PlaceholderText = "ใส่ Key ที่นี่..."
	inputBox.PlaceholderColor3 = theme.SubText
	inputBox.Text = ""
	inputBox.TextXAlignment = Enum.TextXAlignment.Center
	inputBox.Parent = inputBg

	local statusLabel = label(main, "", 12, theme.Error)
	statusLabel.Position = UDim2.new(0, 16, 0, 136)
	statusLabel.Size = UDim2.new(1, -32, 0, 20)
	statusLabel.TextXAlignment = Enum.TextXAlignment.Center

	local submitBtn = Instance.new("TextButton")
	submitBtn.Size = UDim2.new(1, -32, 0, 36)
	submitBtn.Position = UDim2.new(0, 16, 0, 164)
	submitBtn.BackgroundColor3 = theme.Accent
	submitBtn.BorderSizePixel = 0
	submitBtn.Text = "เข้าใช้งาน"
	submitBtn.Font = Enum.Font.GothamBold
	submitBtn.TextSize = 14
	submitBtn.TextColor3 = theme.Text
	submitBtn.Parent = main
	round(submitBtn, 8)

	local function verify(key)
		for _, k in ipairs(correctKeys) do
			if key == k then return true end
		end
		return false
	end

	submitBtn.MouseButton1Click:Connect(function()
		local key = inputBox.Text
		if verify(key) then
			verified = true
			statusLabel.TextColor3 = theme.Success
			statusLabel.Text = "✓ Key ถูกต้อง!"
			tween(main, 0.3, {Size = UDim2.new(0, 400, 0, 0)})
			task.delay(0.3, function()
				gui:Destroy()
				if callback then callback() end
			end)
		else
			statusLabel.Text = "✕ Key ไม่ถูกต้อง กรุณาลองใหม่"
			tween(inputBg, 0.1, {BackgroundColor3 = theme.Error})
			task.delay(0.2, function()
				tween(inputBg, 0.2, {BackgroundColor3 = theme.Element})
			end)
		end
	end)

	inputBox.FocusLost:Connect(function()
		submitBtn.MouseButton1Click:Fire()
	end)

	return {
		Verified = function() return verified end,
		Destroy = function() gui:Destroy() end
	}
end

