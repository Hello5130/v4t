		mobileBtn.TextSize = 24
		mobileBtn.TextColor3 = theme.Text
		mobileBtn.Parent = gui
		round(mobileBtn, 25)
		
		local mobileDragging = false
		mobileBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				mobileDragging = true
			end
		end)
		mobileBtn.InputEnded:Connect(function()
			mobileDragging = false
		end)
		UserInputService.InputChanged:Connect(function(input)
			if mobileDragging and input.UserInputType == Enum.UserInputType.Touch then
				mobileBtn.Position = UDim2.new(0, input.Position.X - 25, 0, input.Position.Y - 25)
			end
		end)
		
		mobileBtn.MouseButton1Click:Connect(function()
			visible = not visible
			main.Visible = visible
		end)
	end

	local Window = {
		Tabs = {},
		Elements = {},
		Theme = theme,
		GUI = gui,
		Main = main,
		ConfigName = configName,
		SavedConfig = savedConfig,
	}

	function Window:Destroy()
		gui:Destroy()
	end

	function Window:Hide()
		main.Visible = false
	end

	function Window:Show()
		main.Visible = true
	end

	-- Notification System
	function Window:Notify(cfg)
		cfg = cfg or {}
		local notifGui = Instance.new("ScreenGui")
		notifGui.Name = "NovaNotification"
		notifGui.ResetOnSpawn = false
		notifGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		notifGui.Parent = RunService:IsStudio()
			and LocalPlayer:WaitForChild("PlayerGui")
			or (gethui and gethui() or game:GetService("CoreGui"))

		local notifFrame = Instance.new("Frame")
		notifFrame.Size = UDim2.new(0, 280, 0, 0)
		notifFrame.Position = UDim2.new(1, -300, 1, -100)
		notifFrame.BackgroundColor3 = theme.Panel
		notifFrame.BorderSizePixel = 0
		notifFrame.ClipsDescendants = true
		notifFrame.Parent = notifGui
		round(notifFrame, 10)
		stroke(notifFrame)

		local notifTitle = label(notifFrame, cfg.Title or "Notification", 13, theme.Text, true)
		notifTitle.Position = UDim2.new(0, 14, 0, 10)
		notifTitle.Size = UDim2.new(1, -28, 0, 18)

		local notifBody = label(notifFrame, cfg.Content or "", 12, theme.SubText)
		notifBody.Position = UDim2.new(0, 14, 0, 30)
		notifBody.Size = UDim2.new(1, -28, 0, 16)
		notifBody.TextWrapped = true

		local notifDuration = cfg.Duration or 3

		tween(notifFrame, 0.3, {Size = UDim2.new(0, 280, 0, 60)})

		task.delay(notifDuration, function()
			tween(notifFrame, 0.3, {Position = UDim2.new(1, 20, 1, -100)})
			task.delay(0.3, function()
				notifGui:Destroy()
			end)
		end)
	end

	-- Save Config
	function Window:SaveConfig()
		if not self.ConfigName then return end
		local data = {}
		for name, element in pairs(self.Elements) do
			if element.Type == "Toggle" then
				data[name] = {Type = "Toggle", Value = element.State}
			elseif element.Type == "Slider" then
				data[name] = {Type = "Slider", Value = element.Value}
			elseif element.Type == "Dropdown" then
				data[name] = {Type = "Dropdown", Value = element.Value}
			elseif element.Type == "Keybind" then
				data[name] = {Type = "Keybind", Value = element.Value}
			elseif element.Type == "Input" then
				data[name] = {Type = "Input", Value = element.Value}
			end
		end
		ConfigSystem:Save(self.ConfigName, data)
	end

	--===========================================================
	-- TAB
	--===========================================================
	function Window:CreateTab(name)
		local tabBtn = Instance.new("TextButton")
		tabBtn.Size = UDim2.new(1, 0, 0, 34)
		tabBtn.BackgroundColor3 = theme.Element
		tabBtn.BackgroundTransparency = 1
		tabBtn.Text = name
		tabBtn.Font = Enum.Font.GothamBold
		tabBtn.TextSize = 13
		tabBtn.TextColor3 = theme.SubText
		tabBtn.AutoButtonColor = false
		tabBtn.Parent = tabList
		round(tabBtn, 6)

		local page = Instance.new("ScrollingFrame")
		page.Size = UDim2.new(1, 0, 1, 0)
		page.BackgroundTransparency = 1
		page.ScrollBarThickness = 3
		page.ScrollBarImageColor3 = theme.Accent
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.CanvasSize = UDim2.new(0, 0, 0, 0)
		page.Visible = false
		page.Parent = content

		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0, 8)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = page
		local pad = Instance.new("UIPadding")
		pad.PaddingRight = UDim.new(0, 4)
		pad.Parent = page

		local function selectTab()
			for _, t in pairs(Window.Tabs) do
				t.Page.Visible = false
				tween(t.Button, 0.2, {BackgroundTransparency = 1})
				t.Button.TextColor3 = theme.SubText
			end
			page.Visible = true
			tween(tabBtn, 0.2, {BackgroundTransparency = 0})
			tabBtn.TextColor3 = theme.Text
		end
		tabBtn.MouseButton1Click:Connect(selectTab)

		table.insert(Window.Tabs, {Button = tabBtn, Page = page})
		if #Window.Tabs == 1 then selectTab() end

		local Tab = {}

		local function newElement(height)
			local holder = Instance.new("Frame")
			holder.Size = UDim2.new(1, 0, 0, height)
			holder.BackgroundColor3 = theme.Panel
			holder.BorderSizePixel = 0
			holder.Parent = page
			round(holder, 8)
			stroke(holder)
			return holder
		end

		local function registerElement(name, data)
			if name then
				Window.Elements[name] = data
				if savedConfig and savedConfig[name] then
					local saved = savedConfig[name]
					if saved.Type == data.Type then
						if data.Type == "Toggle" and data.Set then
							task.defer(function() data.Set(saved.Value) end)
						elseif data.Type == "Slider" and data.Set then
							task.defer(function() data.Set(saved.Value) end)
						elseif data.Type == "Dropdown" and data.Set then
							task.defer(function() data.Set(saved.Value) end)
						elseif data.Type == "Keybind" and data.Set then
							task.defer(function() data.Set(saved.Value) end)
						elseif data.Type == "Input" and data.Set then
							task.defer(function() data.Set(saved.Value) end)
						end
					end
				end
			end
		end

		-- Section
		function Tab:CreateSection(name)
			local l = label(page, string.upper(name), 11, theme.Accent, true)
			l.Size = UDim2.new(1, 0, 0, 18)
			return {Set = function(_, t) l.Text = string.upper(t) end}
		end

		-- Label
		function Tab:CreateLabel(text)
			local holder = newElement(32)
			local l = label(holder, text, 13, theme.Text)
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(1, -24, 1, 0)
			return {Set = function(_, t) l.Text = t end}
		end

		-- Paragraph
		function Tab:CreateParagraph(titleText, bodyText)
			local holder = newElement(64)
			local t = label(holder, titleText, 13, theme.Text, true)
			t.Position = UDim2.new(0, 12, 0, 8)
			t.Size = UDim2.new(1, -24, 0, 16)
			local b = label(holder, bodyText, 12, theme.SubText)
			b.Position = UDim2.new(0, 12, 0, 26)
			b.Size = UDim2.new(1, -24, 1, -30)
			b.TextWrapped = true
			b.TextYAlignment = Enum.TextYAlignment.Top
			return {Set = function(_, nt, nb) t.Text = nt; b.Text = nb end}
		end

		-- Button
		function Tab:CreateButton(cfg)
			local holder = newElement(40)
			local l = label(holder, cfg.Name, 13, theme.Text)
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(1, -24, 1, 0)
			local click = button(holder)
			click.Size = UDim2.new(1, 0, 1, 0)
			click.MouseButton1Click:Connect(function()
				tween(holder, 0.1, {BackgroundColor3 = theme.Accent})
				task.delay(0.15, function()
					tween(holder, 0.3, {BackgroundColor3 = theme.Panel})
				end)
				if cfg.Callback then task.spawn(cfg.Callback) end
			end)
			return {Set = function(_, t) l.Text = t end}
		end

		-- Toggle
		function Tab:CreateToggle(cfg)
			local holder = newElement(40)
			local l = label(holder, cfg.Name, 13, theme.Text)
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(1, -70, 1, 0)

			local track = Instance.new("Frame")
			track.Size = UDim2.new(0, 44, 0, 22)
			track.Position = UDim2.new(1, -56, 0.5, -11)
			track.BackgroundColor3 = theme.Element
			track.BorderSizePixel = 0
			track.Parent = holder
			round(track, 11)

			local knob = Instance.new("Frame")
			knob.Size = UDim2.new(0, 16, 0, 16)
			knob.Position = UDim2.new(0, 3, 0.5, -8)
			knob.BackgroundColor3 = theme.Text
			knob.BorderSizePixel = 0
			knob.Parent = track
			round(knob, 8)

			local state = cfg.CurrentValue or false
			local api = {}
			function api:Set(v)
				state = v
				tween(track, 0.2, {BackgroundColor3 = v and theme.Accent or theme.Element})
				tween(knob, 0.2, {Position = v and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)})
				if cfg.Callback then task.spawn(cfg.Callback, v) end
				if cfg.Flag then
					registerElement(cfg.Flag, {Type = "Toggle", State = state, Set = api.Set})
					Window:SaveConfig()
				end
			end
			local click = button(holder)
			click.Size = UDim2.new(1, 0, 1, 0)
			click.MouseButton1Click:Connect(function() api:Set(not state) end)
			if state then task.defer(function() api:Set(true) end) end
			
			if cfg.Flag then
				registerElement(cfg.Flag, {Type = "Toggle", State = state, Set = api.Set})
			end
			return api
		end

		-- Slider
		function Tab:CreateSlider(cfg)
			local holder = newElement(52)
			local l = label(holder, cfg.Name, 13, theme.Text)
			l.Position = UDim2.new(0, 12, 0, 8)
			l.Size = UDim2.new(0.7, 0, 0, 16)

			local val = label(holder, tostring(cfg.CurrentValue or cfg.Range[1]), 12, theme.Accent, true)
			val.Position = UDim2.new(0.7, 0, 0, 8)
			val.Size = UDim2.new(0.3, -12, 0, 16)
			val.TextXAlignment = Enum.TextXAlignment.Right

			local bar = Instance.new("Frame")
			bar.Size = UDim2.new(1, -24, 0, 6)
			bar.Position = UDim2.new(0, 12, 0, 34)
			bar.BackgroundColor3 = theme.Element
			bar.BorderSizePixel = 0
			bar.Parent = holder
			round(bar, 3)

			local fill = Instance.new("Frame")
			fill.Size = UDim2.new(0, 0, 1, 0)
			fill.BackgroundColor3 = theme.Accent
			fill.BorderSizePixel = 0
			fill.Parent = bar
			round(fill, 3)

			local min, max = cfg.Range[1], cfg.Range[2]
			local step = cfg.Increment or 1
			local current = cfg.CurrentValue or min
			local sliding = false
			local api = {}

			local function setFromX(x)
				local pct = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
				local raw = min + (max - min) * pct
				current = math.floor(raw / step + 0.5) * step
				current = math.clamp(current, min, max)
				tween(fill, 0.05, {Size = UDim2.new((current - min) / (max - min), 0, 1, 0)})
				val.Text = tostring(current)
				if cfg.Callback then task.spawn(cfg.Callback, current) end
				if cfg.Flag then
					registerElement(cfg.Flag, {Type = "Slider", Value = current, Set = api.Set})
					Window:SaveConfig()
				end
			end

			function api:Set(v)
				current = math.clamp(v, min, max)
				fill.Size = UDim2.new((current - min) / (max - min), 0, 1, 0)
				val.Text = tostring(current)
				if cfg.Callback then task.spawn(cfg.Callback, current) end
				if cfg.Flag then
					registerElement(cfg.Flag, {Type = "Slider", Value = current, Set = api.Set})
					Window:SaveConfig()
				end
			end

			bar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					sliding = true
					setFromX(input.Position.X)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
					setFromX(input.Position.X)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					sliding = false
				end
			end)

			task.defer(function() api:Set(current) end)
			
			if cfg.Flag then
				registerElement(cfg.Flag, {Type = "Slider", Value = current, Set = api.Set})
			end
			return api
		end

		-- Input
		function Tab:CreateInput(cfg)
			local holder = newElement(40)
			local l = label(holder, cfg.Name, 13, theme.Text)
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(0.45, 0, 1, 0)

			local boxBg = Instance.new("Frame")
			boxBg.Size = UDim2.new(0.45, -12, 0, 26)
			boxBg.Position = UDim2.new(0.55, 0, 0.5, -13)
			boxBg.BackgroundColor3 = theme.Element
			boxBg.BorderSizePixel = 0
			boxBg.Parent = holder
			round(boxBg, 6)

			local box = Instance.new("TextBox")
			box.Size = UDim2.new(1, -12, 1, 0)
			box.Position = UDim2.new(0, 6, 0, 0)
			box.BackgroundTransparency = 1
			box.Font = Enum.Font.Gotham
			box.TextSize = 12
			box.TextColor3 = theme.Text
			box.PlaceholderText = cfg.PlaceholderText or ""
			box.PlaceholderColor3 = theme.SubText
			box.Text = cfg.CurrentValue or ""
			box.ClearTextOnFocus = false
			box.TextXAlignment = Enum.TextXAlignment.Left
			box.Parent = boxBg

			local api = {
				Set = function(_, t) box.Text = t end,
				Value = cfg.CurrentValue or ""
			}

			box.FocusLost:Connect(function(enter)
				api.Value = box.Text
				if enter and cfg.Callback then task.spawn(cfg.Callback, box.Text) end
				if cfg.Flag then
					registerElement(cfg.Flag, {Type = "Input", Value = box.Text, Set = api.Set})
					Window:SaveConfig()
				end
			end)
			
			if cfg.Flag then
				registerElement(cfg.Flag, {Type = "Input", Value = box.Text, Set = api.Set})
			end
			return api
		end

		-- Dropdown
		function Tab:CreateDropdown(cfg)
			local open = false
			local optionHeight = 26
			local holder = newElement(40)

			local l = label(holder, cfg.Name, 13, theme.Text)
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(0.45, 0, 0, 40)

			local selected = label(holder, cfg.CurrentOption or cfg.Options[1] or "-", 12, theme.Accent, true)
			selected.Position = UDim2.new(0.45, 0, 0, 0)
			selected.Size = UDim2.new(0.55, -12, 0, 40)
			selected.TextXAlignment = Enum.TextXAlignment.Right

			local listFrame = Instance.new("Frame")
			listFrame.Size = UDim2.new(1, -24, 0, 0)
			listFrame.Position = UDim2.new(0, 12, 0, 42)
			listFrame.BackgroundColor3 = theme.Element
			listFrame.BorderSizePixel = 0
			listFrame.ClipsDescendants = true
			listFrame.Parent = holder
			round(listFrame, 6)

			local listLayout = Instance.new("UIListLayout")
			listLayout.Parent = listFrame

			local current = cfg.CurrentOption or cfg.Options[1]
			local api = {}

			local function refresh()
				for _, c in ipairs(listFrame:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				for _, opt in ipairs(cfg.Options) do
					local ob = Instance.new("TextButton")
					ob.Size = UDim2.new(1, 0, 0, optionHeight)
					ob.BackgroundTransparency = 1
					ob.Font = Enum.Font.Gotham
					ob.TextSize = 12
					ob.TextColor3 = opt == current and theme.Accent or theme.SubText
					ob.Text = opt
					ob.Parent = listFrame
					ob.MouseButton1Click:Connect(function()
						api:Set(opt)
						open = false
						tween(holder, 0.2, {Size = UDim2.new(1, 0, 0, 40)})
					end)
				end
			end

			function api:Set(opt)
				current = opt
				selected.Text = opt
				if cfg.Callback then task.spawn(cfg.Callback, opt) end
				if cfg.Flag then
					registerElement(cfg.Flag, {Type = "Dropdown", Value = current, Set = api.Set})
					Window:SaveConfig()
				end
			end
			function api:Refresh(opts)
				cfg.Options = opts
				refresh()
			end

			local click = button(holder)
			click.Size = UDim2.new(1, 0, 0, 40)
			click.MouseButton1Click:Connect(function()
				open = not open
				local target = open and (46 + #cfg.Options * optionHeight) or 40
				tween(holder, 0.2, {Size = UDim2.new(1, 0, 0, target)})
			end)

			refresh()
			
			if cfg.Flag then
				registerElement(cfg.Flag, {Type = "Dropdown", Value = current, Set = api.Set})
			end
			return api
		end

		-- Keybind
		function Tab:CreateKeybind(cfg)
			local holder = newElement(40)
			local l = label(holder, cfg.Name, 13, theme.Text)
			l.Position = UDim2.new(0, 12, 0, 0)
			l.Size = UDim2.new(0.6, 0, 1, 0)

			local bindBg = Instance.new("Frame")
			bindBg.Size = UDim2.new(0, 90, 0, 24)
			bindBg.Position = UDim2.new(1, -102, 0.5, -12)
			bindBg.BackgroundColor3 = theme.Element
			bindBg.BorderSizePixel = 0
			bindBg.Parent = holder
			round(bindBg, 6)

			local bindLabel = label(bindBg, cfg.CurrentKeybind or "None", 12, theme.Text, true)
			bindLabel.Size = UDim2.new(1, 0, 1, 0)
			bindLabel.TextXAlignment = Enum.TextXAlignment.Center

			local binding = false
			local current = cfg.CurrentKeybind
			local api = {}

			function api:Set(k)
				current = k
				bindLabel.Text = k or "None"
				if cfg.Flag then
					registerElement(cfg.Flag, {Type = "Keybind", Value = current, Set = api.Set})
					Window:SaveConfig()
				end
			end

			local click = button(holder)
			click.Size = UDim2.new(1, 0, 1, 0)
			click.MouseButton1Click:Connect(function()
				binding = true
				bindLabel.Text = "..."
			end)

			UserInputService.InputBegan:Connect(function(input, gpe)
				if binding and input.UserInputType == Enum.UserInputType.Keyboard then
					binding = false
					current = input.KeyCode.Name
					bindLabel.Text = current
					if cfg.Callback then task.spawn(cfg.Callback, current) end
					if cfg.Flag then
						registerElement(cfg.Flag, {Type = "Keybind", Value = current, Set = api.Set})
						Window:SaveConfig()
					end
				elseif not gpe and not binding and current and input.KeyCode.Name == current then
					if cfg.OnPressed then task.spawn(cfg.OnPressed) end
				end
			end)

			if cfg.Flag then
				registerElement(cfg.Flag, {Type = "Keybind", Value = current, Set = api.Set})
			end
			return api
		end

		return Tab
	end

	return Window
end

return Nova
